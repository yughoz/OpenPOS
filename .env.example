# PocketBase (auth + database Azkasir)
POCKETBASE_URL=http://127.0.0.1:8094

# Kredensial superuser PocketBase — dipakai server (service layer) & script setup:db
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Seed akun admin pertama (hanya dibuat kalau collection users masih kosong)
SEED_ADMIN_EMAIL=admin@azkasir.local
SEED_ADMIN_PASSWORD=azkasir123

# Asisten AI (/app/ai-chat) — provider OpenAI-compatible (OpenAI, proxy, dsb.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
