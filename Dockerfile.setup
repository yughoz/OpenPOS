# Image seeder: menjalankan scripts/setup-pocketbase.ts sekali terhadap
# PocketBase instance app (dipakai sebagai service `setup` oleh NekoApps).
FROM oven/bun:1
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY scripts ./scripts
COPY project.inlang ./
COPY messages.inlang ./messages.inlang
COPY tsconfig.json vite.config.ts ./

CMD ["bun", "scripts/setup-pocketbase.ts"]
